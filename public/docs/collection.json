{
    "variable": [
        {
            "id": "baseUrl",
            "key": "baseUrl",
            "type": "string",
            "name": "string",
            "value": "http:\/\/127.0.0.1.nip.io"
        }
    ],
    "info": {
        "name": "INVENT-MAG API Documentation",
        "_postman_id": "fc42be41-b205-45f1-9cb4-8ba70b2e32dc",
        "description": "Invent-MAG exposes a deliberately small REST API covering authentication, tenant discovery, CMS content, marketing plan pricing, payment confirmations, and Midtrans webhooks. All other functionality is served by the session-authenticated web admin panel (`\/admin\/*`) and is intentionally not part of the API.",
        "schema": "https:\/\/schema.getpostman.com\/json\/collection\/v2.1.0\/collection.json"
    },
    "item": [
        {
            "name": "Authentication",
            "description": "Public registration, login, and tenant lookup, plus token refresh for authenticated clients.",
            "item": [
                {
                    "name": "Log in and receive an API token.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/login",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/login"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"email\":\"qkunze@example.com\",\"password\":\"O[2UZ5ij-e\\\/dl4m{o,\"}"
                        },
                        "description": "Authenticates the user with email and password and returns a Sanctum\nbearer token for authenticated API calls. Rate-limited to 5 requests\nper minute per IP.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"token\": \"1|abcdefghijklmnopqrstuvwxyz\",\n  \"token_type\": \"Bearer\"\n}",
                            "name": "success"
                        },
                        {
                            "header": [],
                            "code": 401,
                            "body": "{\n  \"message\": \"Invalid login details\"\n}",
                            "name": "invalid credentials"
                        }
                    ]
                },
                {
                    "name": "Register a new user and tenant.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/register",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/register"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"name\":\"consequatur\",\"shopname\":\"consequatur\",\"email\":\"qkunze@example.com\",\"password\":\"O[2UZ5ij-e\\\/dl4m{o,\",\"plan\":\"professional\",\"password_confirmation\":\"consequatur\"}"
                        },
                        "description": "Creates a user account and its tenant (workspace) in one call, then\nreturns an access token for immediate use. Rate-limited to 3 per hour\nper IP.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 201,
                            "body": "{\n  \"message\": \"Registration successful\",\n  \"user\": {\n    \"name\": \"Jane Doe\",\n    \"email\": \"jane@example.com\",\n    \"updated_at\": \"2026-08-12T09:00:00.000000Z\",\n    \"created_at\": \"2026-08-12T09:00:00.000000Z\",\n    \"id\": 1\n  },\n  \"access_token\": \"1|abcdefghijklmnopqrstuvwxyz\",\n  \"token_type\": \"Bearer\",\n  \"tenant_domain\": \"mycompany.invent-mag.web.id\",\n  \"workspace_slug\": \"mycompany\",\n  \"plan\": {\n    \"name\": \"Starter\",\n    \"slug\": \"starter\",\n    \"status\": \"trial\",\n    \"on_trial\": true,\n    \"trial_ends_at\": \"2026-09-11T09:00:00.000000Z\"\n  }\n}",
                            "name": "success"
                        },
                        {
                            "header": [],
                            "code": 422,
                            "body": "{\n  \"message\": \"The shopname has already been taken. (and 2 more errors)\",\n  \"errors\": {\n    \"shopname\": [\n      \"The shopname has already been taken.\"\n    ],\n    \"email\": [\n      \"The email has already been taken.\"\n    ]\n  }\n}",
                            "name": "validation error"
                        }
                    ]
                },
                {
                    "name": "Find a tenant's workspace by shop name.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/lookup-tenant",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/lookup-tenant"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"shopname\":\"consequatur\"}"
                        },
                        "description": "Resolves a shop name to its workspace slug, used by the marketing-site\nlogin portal before authenticating. Matches by domain prefix first, then\nby tenant name.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"tenant_domain\": \"mycompany.invent-mag.web.id\",\n  \"workspace_slug\": \"mycompany\"\n}",
                            "name": "success"
                        },
                        {
                            "header": [],
                            "code": 404,
                            "body": "{\n  \"message\": \"Shop not found.\"\n}",
                            "name": "not found"
                        },
                        {
                            "header": [],
                            "code": 422,
                            "body": "{\n  \"message\": \"The shopname field is required.\",\n  \"errors\": {\n    \"shopname\": [\n      \"The shopname field is required.\"\n    ]\n  }\n}",
                            "name": "validation error"
                        }
                    ]
                },
                {
                    "name": "Refresh the current API token.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/v1\/refresh-token",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/v1\/refresh-token"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "Revokes the current token and issues a new one with a one-day expiry.\nCall this with the token you want to replace."
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"token\": \"2|abcdefghijklmnopqrstuvwxyz\",\n  \"expires_at\": \"2026-08-13T09:00:00.000000Z\"\n}",
                            "name": "success"
                        }
                    ]
                }
            ]
        },
        {
            "name": "CMS Content",
            "description": "Public landing-page content and billing rate served to the Astro marketing site at build time.",
            "item": [
                {
                    "name": "Get marketing-site CMS content.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/cms",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/cms"
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "Returns the landing-page copy (hero, features, pricing, CTA, footer)\nserved to the Astro marketing site at build time. Also includes the\ncurrent USD\u2192IDR billing rate, computed live from `BillingSetting::getRate()`\n(superadmin-managed at Superadmin \u2192 Settings \u2192 Billing Rate), falling back\nto `config\/billing.php`. Responses are cached for 1 hour.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"hero_title\": \"The All-In-One ERP to Streamline Your Business\",\n  \"hero_subtitle\": \"From inventory and sales to a full accounting suite, Invent-MAG provides the tools you need to make smarter, data-driven decisions and accelerate your growth.\",\n  \"pricing_badge\": \"Simple, transparent pricing\",\n  \"pricing_title\": \"One platform, every tool your business needs\",\n  \"pricing_most_popular_badge\": \"most popular\",\n  \"billing_rate\": 16000,\n  \"cta_title\": \"Ready to streamline your business?\",\n  \"contact_email\": \"jefrydwijaya3@gmail.com\",\n  \"footer_text\": \"\u00a9 2026 Invent-MAG. All rights reserved.\"\n}",
                            "name": "success"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Plans",
            "description": "Subscription plan pricing (public) and authenticated plan\/usage data.",
            "item": [
                {
                    "name": "Get active subscription plans (public pricing data).",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/plans",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/plans"
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "Returns the active plans used by the marketing-site pricing cards\n(`invent-mag-fe\/src\/lib\/plans.ts` fetches this at build time). Only\ndisplay-oriented fields are exposed \u2014 no relations or internals.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"data\": [\n    {\n      \"slug\": \"starter\",\n      \"name\": \"Starter\",\n      \"description\": \"Everything you need to manage inventory and orders.\",\n      \"price\": 19,\n      \"currency_code\": \"USD\",\n      \"billing_cycle\": \"monthly\",\n      \"trial_days\": 30,\n      \"max_users\": 3,\n      \"max_warehouses\": 1,\n      \"max_products\": 100,\n      \"features\": []\n    }\n  ],\n  \"meta\": {\n    \"currency_code\": \"USD\"\n  }\n}",
                            "name": "success"
                        }
                    ]
                },
                {
                    "name": "List active plans (authenticated).",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/v1\/plans",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/v1\/plans"
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "Returns the full active plan records for an authenticated client."
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "[\n  {\n    \"slug\": \"starter\",\n    \"name\": \"Starter\",\n    \"price\": \"19.00\",\n    \"currency_code\": \"USD\",\n    \"billing_cycle\": \"monthly\",\n    \"trial_days\": 30,\n    \"max_users\": 3,\n    \"max_warehouses\": 1,\n    \"max_products\": 100,\n    \"features\": [],\n    \"is_active\": true,\n    \"sort_order\": 1\n  }\n]",
                            "name": "success"
                        }
                    ]
                },
                {
                    "name": "Get the current tenant's plan usage statistics.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/v1\/plan\/current",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/v1\/plan\/current"
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "Returns the authenticated tenant's effective plan along with current\nusage against plan limits (users, warehouses, products) and trial status."
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"plan\": {\n    \"slug\": \"professional\",\n    \"name\": \"Professional\",\n    \"price\": \"59.00\",\n    \"max_users\": 10,\n    \"max_warehouses\": -1,\n    \"max_products\": 500\n  },\n  \"tenant\": {\n    \"name\": \"My Company\",\n    \"domain\": \"mycompany.invent-mag.web.id\"\n  },\n  \"users\": {\n    \"current\": 3,\n    \"limit\": 10,\n    \"unlimited\": false,\n    \"percentage\": 30\n  },\n  \"warehouses\": {\n    \"current\": 2,\n    \"limit\": -1,\n    \"unlimited\": true,\n    \"percentage\": 0\n  },\n  \"products\": {\n    \"current\": 150,\n    \"limit\": 500,\n    \"unlimited\": false,\n    \"percentage\": 30\n  },\n  \"trial\": {\n    \"on_trial\": true,\n    \"days_remaining\": 18\n  }\n}",
                            "name": "success"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Payments",
            "description": "Payment confirmation for Midtrans Snap transactions.",
            "item": [
                {
                    "name": "Confirm payment after a successful Midtrans Snap transaction.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/payment\/confirm",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/payment\/confirm"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"order_id\":\"consequatur\",\"transaction_result\":[]}"
                        },
                        "description": "Verifies the order belongs to the current tenant, checks the Midtrans\ntransaction status, and marks the order paid. Use this after the\nfrontend completes a Snap transaction so the plan updates immediately\nwithout waiting for the webhook."
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"message\": \"Payment confirmed successfully\",\n  \"plan\": \"Professional\"\n}",
                            "name": "success"
                        },
                        {
                            "header": [],
                            "code": 400,
                            "body": "{\n  \"message\": \"Payment not completed\",\n  \"status\": \"pending\"\n}",
                            "name": "payment not completed"
                        },
                        {
                            "header": [],
                            "code": 404,
                            "body": "{\n  \"message\": \"Order not found\"\n}",
                            "name": "order not found"
                        },
                        {
                            "header": [],
                            "code": 500,
                            "body": "{\n  \"message\": \"Payment verification failed. Please try again later.\"\n}",
                            "name": "verification failure"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Webhooks",
            "description": "Midtrans payment notification endpoints.",
            "item": [
                {
                    "name": "Handle a Midtrans payment notification webhook.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/webhooks\/midtrans",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/webhooks\/midtrans"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"order_id\":\"consequatur\",\"status_code\":\"consequatur\",\"gross_amount\":\"consequatur\",\"signature_key\":\"consequatur\",\"transaction_status\":\"consequatur\"}"
                        },
                        "description": "Receives Midtrans transaction notifications, verifies the SHA-512\nsignature, and updates the matching subscription order (paid on\n`capture`\/`settlement`, failed on `cancel`\/`deny`\/`expire`). Configure\nthis URL in the Midtrans dashboard; `POST \/api\/webhook` is a fallback\nalias for misconfigured dashboards.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"message\": \"Webhook handled successfully\"\n}",
                            "name": "success"
                        },
                        {
                            "header": [],
                            "code": 400,
                            "body": "{\n  \"message\": \"Invalid payload\"\n}",
                            "name": "invalid payload"
                        },
                        {
                            "header": [],
                            "code": 403,
                            "body": "{\n  \"message\": \"Invalid signature\"\n}",
                            "name": "bad signature"
                        },
                        {
                            "header": [],
                            "code": 404,
                            "body": "{\n  \"message\": \"Order not found\"\n}",
                            "name": "order not found"
                        }
                    ]
                },
                {
                    "name": "Handle a Midtrans payment notification webhook (fallback alias).",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/webhook",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/webhook"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"order_id\":\"consequatur\",\"status_code\":\"consequatur\",\"gross_amount\":\"consequatur\",\"signature_key\":\"consequatur\",\"transaction_status\":\"consequatur\"}"
                        },
                        "description": "Identical to `POST \/api\/webhooks\/midtrans`, exposed as a fallback alias\nfor Midtrans dashboards that were configured with the bare `\/webhook` URL.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"message\": \"Webhook handled successfully\"\n}",
                            "name": "success"
                        },
                        {
                            "header": [],
                            "code": 400,
                            "body": "{\n  \"message\": \"Invalid payload\"\n}",
                            "name": "invalid payload"
                        },
                        {
                            "header": [],
                            "code": 403,
                            "body": "{\n  \"message\": \"Invalid signature\"\n}",
                            "name": "bad signature"
                        },
                        {
                            "header": [],
                            "code": 404,
                            "body": "{\n  \"message\": \"Order not found\"\n}",
                            "name": "order not found"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Contact",
            "description": "Marketing-site contact form submission.",
            "item": [
                {
                    "name": "Handle the marketing-site contact form submission.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/contact",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/contact"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"name\":\"consequatur\",\"email\":\"qkunze@example.com\",\"company\":\"consequatur\",\"topic\":\"support\",\"message\":\"consequatur\",\"botcheck\":\"consequatur\"}"
                        },
                        "description": "Validates the form, passes the built-in honeypot (`botcheck` must stay\nempty), and emails the platform contact address.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"success\": true,\n  \"message\": \"Message sent successfully!\"\n}",
                            "name": "success"
                        },
                        {
                            "header": [],
                            "code": 422,
                            "body": "{\n  \"success\": false,\n  \"message\": \"Validation failed\",\n  \"errors\": {\n    \"email\": [\n      \"The email field must be a valid email address.\"\n    ]\n  }\n}",
                            "name": "validation error"
                        },
                        {
                            "header": [],
                            "code": 500,
                            "body": "{\n  \"success\": false,\n  \"message\": \"Failed to send message. Please try again.\"\n}",
                            "name": "mail failure"
                        }
                    ]
                }
            ]
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "Authorization",
                "type": "string"
            }
        ]
    }
}